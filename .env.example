# Firebase Authentication Configuration
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Security: Authorized Administrator Emails (comma-separated)
# Only users signed in with these email addresses will be granted access to the Admin Panel.
# Default approved emails: admin@kcc.lk, principal@kcc.lk, kcckopay@gmail.com, sivodayan17@gmail.com
VITE_ADMIN_EMAILS=admin@kcc.lk,principal@kcc.lk,kcckopay@gmail.com,sivodayan17@gmail.com

